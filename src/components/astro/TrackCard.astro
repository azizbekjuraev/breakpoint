---
interface Props {
  track: 'js' | 'react';
  title: string;
  description: string;
  bugIds: string[];
}
const { track, title, description, bugIds } = Astro.props;
const count = bugIds.length;
const href = count > 0 ? `/tracks/${track}` : '#';
const disabled = count === 0;
---
<a
  href={href}
  class:list={[
    'block p-6 rounded-lg border border-neutral-200 dark:border-neutral-800 transition',
    disabled
      ? 'opacity-50 pointer-events-none'
      : 'hover:border-neutral-400 dark:hover:border-neutral-600',
  ]}
>
  <div class="flex items-baseline justify-between mb-2">
    <h2 class="text-xl font-semibold">{title}</h2>
    <span class="text-sm text-neutral-500 font-mono" data-track-bugs={bugIds.join(',')}>
      {count} {count === 1 ? 'bug' : 'bugs'}
    </span>
  </div>
  <p class="text-neutral-600 dark:text-neutral-400 text-sm">{description}</p>
  {disabled && (
    <p class="text-xs text-neutral-400 mt-2">Coming soon</p>
  )}
</a>
