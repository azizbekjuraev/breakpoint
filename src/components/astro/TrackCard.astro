---
import type { Track } from '@/lib/types';

interface Props {
  track: Track;
  title: string;
  description: string;
  bugIds: string[];
}
const { track, title, description, bugIds } = Astro.props;
const count = bugIds.length;
const href = count > 0 ? `/tracks/${track}` : '#';
const disabled = count === 0;
---

<a
  href={href}
  class:list={[
    'block rounded-lg border border-neutral-200 p-6 transition dark:border-neutral-800',
    disabled
      ? 'pointer-events-none opacity-50'
      : 'hover:border-neutral-400 dark:hover:border-neutral-600',
  ]}
>
  <div class="mb-2 flex items-baseline justify-between">
    <h2 class="text-xl font-semibold">{title}</h2>
    <span class="font-mono text-sm text-neutral-500" data-track-bugs={bugIds.join(',')}>
      {count}
      {count === 1 ? 'bug' : 'bugs'}
    </span>
  </div>
  <p class="text-sm text-neutral-600 dark:text-neutral-400">{description}</p>
  {disabled && <p class="mt-2 text-xs text-neutral-400">Coming soon</p>}
</a>
