---
import Layout from '@/components/astro/Layout.astro';
import TrackCard from '@/components/astro/TrackCard.astro';
import { getBugsByTrack } from '@/lib/bugs';

const jsBugs = getBugsByTrack('js');
const reactBugs = getBugsByTrack('react');
---

<Layout title="Tracks — Breakpoint">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a href="/" class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← Home</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">Choose your track</h1>
    <p class="mb-10 text-neutral-500">Two paths. Start where you are.</p>
    <div class="grid gap-4 sm:grid-cols-2">
      <TrackCard
        track="js"
        title="JavaScript"
        description="Scope, closures, async, types. Pure language fundamentals."
        bugIds={jsBugs.map((b) => b.meta.id)}
      />
      <TrackCard
        track="react"
        title="React"
        description="Hooks, state, effects, reconciliation. Assumes JS comfort."
        bugIds={reactBugs.map((b) => b.meta.id)}
      />
    </div>
  </main>
  <script>
    function updateProgress() {
      const KEY = 'breakpoint:progress:v1';
      try {
        const raw = localStorage.getItem(KEY);
        const data = raw ? JSON.parse(raw) : { completed: {} };
        const done = new Set(Object.keys(data.completed));
        document.querySelectorAll('[data-track-bugs]').forEach((el) => {
          const ids = (el.getAttribute('data-track-bugs') || '').split(',').filter(Boolean);
          if (ids.length === 0) return;
          const count = ids.filter((id) => done.has(id)).length;
          el.textContent = count + ' / ' + ids.length;
        });
      } catch {}
    }

    document.addEventListener('astro:page-load', updateProgress);
  </script>
</Layout>
