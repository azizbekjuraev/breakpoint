---
import Layout from '@/components/astro/Layout.astro';
import TrackCard from '@/components/astro/TrackCard.astro';
import { getBugsByTrack } from '@/lib/bugs';
import { ALL_TRACKS, TRACK_META } from '@/lib/types';

const tracks = ALL_TRACKS.map((t) => ({
  track: t,
  meta: TRACK_META[t],
  bugIds: getBugsByTrack(t).map((b) => b.meta.id),
}));
---

<Layout title="Tracks — Breakpoint">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a href="/" class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← Home</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">Choose your track</h1>
    <p class="mb-10 text-neutral-500">Pick a path. Start where you are.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tracks.map((t) => (
          <TrackCard
            track={t.track}
            title={t.meta.label}
            description={t.meta.description}
            bugIds={t.bugIds}
          />
        ))
      }
    </div>
  </main>
  <script>
    import { getProgress } from '@/lib/progress';

    function updateProgress() {
      const done = new Set(Object.keys(getProgress().completed));
      document.querySelectorAll('[data-track-bugs]').forEach((el) => {
        const ids = (el.getAttribute('data-track-bugs') || '').split(',').filter(Boolean);
        if (ids.length === 0) return;
        const count = ids.filter((id) => done.has(id)).length;
        el.textContent = `${count} / ${ids.length}`;
      });
    }

    document.addEventListener('astro:page-load', updateProgress);
  </script>
</Layout>
