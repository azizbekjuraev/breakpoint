---
import Layout from '@/components/astro/Layout.astro';
import BugList from '@/components/react/BugList.tsx';
import { getBugsByTrack } from '@/lib/bugs';
import { LEVELS, getLevelBySlug } from '@/lib/levels';
import { ALL_TRACKS, TRACK_META, type Track } from '@/lib/types';

export function getStaticPaths() {
  return ALL_TRACKS.flatMap((track) =>
    LEVELS.map((l) => ({ params: { track, level: l.slug } })),
  );
}

const { track, level } = Astro.params;
if (!ALL_TRACKS.includes(track as Track)) {
  return Astro.redirect('/tracks');
}
const trackTyped = track as Track;

const levelInfo = level ? getLevelBySlug(level) : undefined;
if (!levelInfo) {
  return Astro.redirect(`/tracks/${track}`);
}

const bugs = getBugsByTrack(trackTyped)
  .filter((b) => b.meta.difficulty === levelInfo.difficulty)
  .map((b) => ({
    id: b.meta.id,
    title: b.meta.title,
    estimatedMinutes: b.meta.estimatedMinutes,
    concepts: b.meta.concepts,
  }));
const trackTitle = TRACK_META[trackTyped].label;
---

<Layout title={`${levelInfo.label} ${trackTitle} — Breakpoint`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a
      href={`/tracks/${track}`}
      class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← {trackTitle}</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">{levelInfo.label}</h1>
    <p class="mb-6 text-neutral-500">{levelInfo.blurb}</p>

    {
      bugs.length === 0 ? (
        <p class="italic text-neutral-500">No bugs in this section yet.</p>
      ) : (
        <BugList bugs={bugs} client:load />
      )
    }
  </main>
</Layout>
