---
import Layout from '@/components/astro/Layout.astro';
import LevelCard from '@/components/astro/LevelCard.astro';
import { getBugsByTrack } from '@/lib/bugs';
import { LEVELS } from '@/lib/levels';

export function getStaticPaths() {
  return [{ params: { track: 'js' } }, { params: { track: 'react' } }];
}

const { track } = Astro.params;
if (track !== 'js' && track !== 'react') {
  return Astro.redirect('/tracks');
}

const bugs = getBugsByTrack(track);
const trackTitle = track === 'js' ? 'JavaScript' : 'React';
const trackDescription =
  track === 'js'
    ? 'Scope, closures, async, types. Pure language fundamentals.'
    : 'Hooks, state, effects, reconciliation. Assumes JS comfort.';

const levels = LEVELS.map((l) => ({
  ...l,
  bugIds: bugs.filter((b) => b.meta.difficulty === l.difficulty).map((b) => b.meta.id),
}));
---

<Layout title={`${trackTitle} — Breakpoint`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a
      href="/tracks"
      class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← Tracks</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">{trackTitle}</h1>
    <p class="mb-10 text-neutral-500">{trackDescription}</p>
    <div class="grid gap-4 md:grid-cols-3">
      {
        levels.map((l) => (
          <LevelCard
            track={track}
            slug={l.slug}
            label={l.label}
            blurb={l.blurb}
            bugIds={l.bugIds}
          />
        ))
      }
    </div>
  </main>
  <script>
    function updateProgress() {
      const KEY = 'breakpoint:progress:v1';
      try {
        const raw = localStorage.getItem(KEY);
        const data = raw ? JSON.parse(raw) : { completed: {} };
        const done = new Set(Object.keys(data.completed));
        document.querySelectorAll('[data-level-bugs]').forEach((el) => {
          const ids = (el.getAttribute('data-level-bugs') || '').split(',').filter(Boolean);
          if (ids.length === 0) return;
          const count = ids.filter((id) => done.has(id)).length;
          el.textContent = count + ' / ' + ids.length;
        });
      } catch {}
    }

    document.addEventListener('astro:page-load', updateProgress);
  </script>
</Layout>
