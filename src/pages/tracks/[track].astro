---
import Layout from '@/components/astro/Layout.astro';
import { getBugsByTrack } from '@/lib/bugs';

export function getStaticPaths() {
  return [{ params: { track: 'js' } }, { params: { track: 'react' } }];
}

const { track } = Astro.params;
if (track !== 'js' && track !== 'react') {
  return Astro.redirect('/tracks');
}

const bugs = getBugsByTrack(track);
const trackTitle = track === 'js' ? 'JavaScript' : 'React';
const trackDescription =
  track === 'js'
    ? 'Scope, closures, async, types. Pure language fundamentals.'
    : 'Hooks, state, effects, reconciliation. Assumes JS comfort.';
---

<Layout title={`${trackTitle} — Breakpoint`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a
      href="/tracks"
      class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← Tracks</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">{trackTitle}</h1>
    <p class="mb-6 text-neutral-500">{trackDescription}</p>
    <p id="track-summary" class="mb-8 font-mono text-sm text-neutral-500">
      {bugs.length}
      {bugs.length === 1 ? 'bug' : 'bugs'}
    </p>

    {
      bugs.length === 0 ? (
        <p class="italic text-neutral-500">No bugs in this track yet.</p>
      ) : (
        <ol class="space-y-2">
          {bugs.map((bug) => (
            <li>
              <a
                href={`/bugs/${bug.meta.id}`}
                data-bug-id={bug.meta.id}
                class="flex items-center justify-between gap-4 rounded-md border border-neutral-200 p-4 transition hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-600"
              >
                <div class="min-w-0">
                  <p class="font-mono text-xs text-neutral-500">{bug.meta.id}</p>
                  <p class="truncate font-medium">{bug.meta.title}</p>
                </div>
                <div class="flex shrink-0 items-center gap-3 text-xs">
                  <span class="text-neutral-500">~{bug.meta.estimatedMinutes}m</span>
                  <span
                    data-check
                    class="hidden font-semibold text-emerald-600 dark:text-emerald-400"
                    aria-label="Completed"
                  >
                    ✓
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </main>
  <script>
    function updateProgress() {
      const KEY = 'breakpoint:progress:v1';
      try {
        const raw = localStorage.getItem(KEY);
        const data = raw ? JSON.parse(raw) : { completed: {} };
        const done = new Set(Object.keys(data.completed));
        const items = document.querySelectorAll('a[data-bug-id]');
        let count = 0;
        items.forEach((item) => {
          if (done.has(item.getAttribute('data-bug-id'))) {
            count++;
            item.setAttribute('data-completed', '');
            const check = item.querySelector('[data-check]');
            if (check) check.classList.remove('hidden');
          }
        });
        const summary = document.getElementById('track-summary');
        if (summary && items.length > 0) {
          summary.textContent = count + ' / ' + items.length + ' completed';
        }
      } catch {}
    }

    document.addEventListener('astro:page-load', updateProgress);
  </script>
</Layout>
