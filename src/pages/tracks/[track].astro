---
import Layout from '@/components/astro/Layout.astro';
import LevelCard from '@/components/astro/LevelCard.astro';
import StatTile from '@/components/astro/StatTile.astro';
import Badge from '@/components/astro/Badge.astro';
import RecentlyViewed from '@/components/react/RecentlyViewed.tsx';
import { getBugsByTrack } from '@/lib/bugs';
import { LEVELS } from '@/lib/levels';
import { getAchievementDefs } from '@/lib/achievements';
import { ALL_TRACKS, TRACK_META, type Track } from '@/lib/types';

export function getStaticPaths() {
  return ALL_TRACKS.map((t) => ({ params: { track: t } }));
}

const { track } = Astro.params;
if (!ALL_TRACKS.includes(track as Track)) {
  return Astro.redirect('/tracks');
}
const trackTyped = track as Track;

const bugs = getBugsByTrack(trackTyped);
const trackBugIds = bugs.map((b) => b.meta.id);
const trackTitle = TRACK_META[trackTyped].label;
const trackDescription = TRACK_META[trackTyped].description;

const levels = LEVELS.map((l) => ({
  ...l,
  bugIds: bugs.filter((b) => b.meta.difficulty === l.difficulty).map((b) => b.meta.id),
}));

const achievementDefs = getAchievementDefs(trackTyped);
---

<Layout title={`${trackTitle} — Breakpoint`}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a
      href="/tracks"
      class="text-sm text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
      >← Tracks</a
    >
    <h1 class="mb-2 mt-6 text-3xl font-semibold">{trackTitle}</h1>
    <p class="mb-10 text-neutral-500">{trackDescription}</p>

    <section class="mb-12 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <StatTile label="Solved" stat="solved" />
      <StatTile label="Streak" stat="streak" />
      <StatTile label="Avg hints" stat="avg-hints" />
      <StatTile label="Avg time" stat="avg-time" />
    </section>

    <div class="grid gap-4 md:grid-cols-3">
      {
        levels.map((l) => (
          <LevelCard
            track={trackTyped}
            slug={l.slug}
            label={l.label}
            blurb={l.blurb}
            bugIds={l.bugIds}
          />
        ))
      }
    </div>

    <div class="mt-12">
      <RecentlyViewed track={trackTyped} limit={5} client:load />
    </div>

    <h2
      class="mb-4 mt-14 font-mono text-[11px] uppercase tracking-wide text-neutral-400"
    >
      Achievements
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        achievementDefs.map((a) => (
          <Badge id={a.id} label={a.label} description={a.description} />
        ))
      }
    </div>
  </main>

  <script
    is:inline
    type="application/json"
    id="bp-track-data"
    set:html={JSON.stringify({ track, trackBugIds })}
  />

  <script>
    import { getProgress } from '@/lib/progress';
    import { computeTrackStats, formatDuration } from '@/lib/stats';
    import { computeTrackAchievements } from '@/lib/achievements';
    import type { Track } from '@/lib/types';

    function hydrate() {
      const dataNode = document.getElementById('bp-track-data');
      if (!dataNode?.textContent) return;
      const { track, trackBugIds } = JSON.parse(dataNode.textContent) as {
        track: Track;
        trackBugIds: string[];
      };

      const progress = getProgress();
      const stats = computeTrackStats(progress, trackBugIds);
      const achievements = computeTrackAchievements({
        track,
        trackBugIds,
        data: progress,
      });

      const setStat = (key: string, value: string) => {
        const el = document.querySelector(`[data-stat="${key}"]`);
        if (el) el.textContent = value;
      };
      setStat('solved', `${stats.solved} / ${stats.total}`);
      setStat('streak', stats.streak === 0 ? '—' : `${stats.streak}d`);
      setStat('avg-hints', stats.avgHints === null ? '—' : stats.avgHints.toFixed(1));
      setStat(
        'avg-time',
        stats.avgDurationMs === null ? '—' : formatDuration(stats.avgDurationMs),
      );

      for (const a of achievements) {
        const el = document.querySelector(`[data-badge="${a.id}"]`);
        if (el) el.setAttribute('data-earned', String(a.earned));
      }

      const done = new Set(Object.keys(progress.completed));
      document.querySelectorAll('[data-level-bugs]').forEach((el) => {
        const ids = (el.getAttribute('data-level-bugs') || '').split(',').filter(Boolean);
        if (ids.length === 0) return;
        const count = ids.filter((id) => done.has(id)).length;
        el.textContent = `${count} / ${ids.length}`;
      });
    }

    document.addEventListener('astro:page-load', hydrate);
  </script>
</Layout>
