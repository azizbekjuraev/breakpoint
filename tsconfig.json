{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"src/*"
			]
		},
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*",
		"scripts/**/*",
		".astro/types.d.ts",
		"astro.config.mjs",
		"tailwind.config.ts",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}